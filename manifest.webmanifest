{
  "name": "GG Player vLG",
  "short_name": "GG Player",
  "description": "GG Player vLG media player for Titan OS browsers.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "fullscreen",
  "orientation": "landscape",
  "background_color": "#090a10",
  "theme_color": "#151a23",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "x-titan-os": {
    "entrypoint": "./index.html",
    "splash_screen": "splash/splash-1920x1080.png",
    "resolution": "1920x1080"
  }
}
